---
/**
 * The open-source explainer.
 *
 * WHY THIS PAGE EXISTS RATHER THAN A BARE LINK. The footer's "Source" link
 * points here, not at GitHub. A repository landing page opens on a file tree,
 * which answers "what is this" badly for someone who has not already decided
 * they want it. This page gives the short answer first and keeps the
 * repository link where nobody can miss it.
 *
 * The site this was forked from is credited in the repository (LICENSE and
 * README), not here. The built site carries the Owner's identity only.
 */
import PageLayout from '../layouts/PageLayout.astro';
import { person } from '../data/person';
import { SOURCE_REPO_URL } from '../data/site';
---

<PageLayout
  seo={{
    title: `Open Source — ${person.name}`,
    description:
      'The code for this site is public and MIT licensed. Read it, fork it, or borrow the parts you like. It is built with Astro and runs on Cloudflare.',
  }}
  heading="Open source"
  lede="The code for this site is public. Read it, fork it, or borrow whatever is useful."
>
  <div class="prose">
    <p>
      {/*
        {' '} around an inline link is deliberate: a newline there collapses to
        nothing and renders the words either side of the link run together.
      */}
      It lives in{' '}
      <a href={SOURCE_REPO_URL} rel="noopener">this site's repository on GitHub</a>.
      It is MIT licensed, so you can use it for anything as long as the license
      file comes with it.
    </p>

    <p>
      Every page is built ahead of time into a plain file and served from
      Cloudflare, so there is no server to keep running. A test suite checks
      every build for the things that are easy to get wrong without noticing:
      missing titles and descriptions, broken links, pages nothing links to,
      and images without alt text. If one fails, the site does not deploy.
    </p>
  </div>
</PageLayout>
