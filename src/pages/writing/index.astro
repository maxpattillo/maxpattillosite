---
/**
 * The Article index.
 *
 * While nothing is published the page says so plainly and offers the feed, so
 * an empty section reads as early rather than broken, and someone who wants
 * the first Article can subscribe before it exists.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import { person } from '../../data/person';
import { articlePath, getPublishedArticles } from '../../utils/collections';

const articles = await getPublishedArticles();

const dateFormat = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

/*
 * Branches with the body, so the search snippet cannot keep saying "nothing
 * published" after the first Article ships.
 */
const description =
  articles.length === 0
    ? `Articles by ${person.name}. Nothing is published yet; subscribe to the RSS feed to get the first one when it lands.`
    : `Articles by ${person.name}, newest first. Subscribe to the RSS feed to get each new one when it is published.`;
---

<PageLayout
  seo={{
    title: `Writing — ${person.name}`,
    description,
  }}
  pageType="CollectionPage"
  heading="Writing"
  width="wide"
>
  {
    articles.length === 0 ? (
      <p class="text-ink-muted">Nothing here yet.</p>
    ) : (
      <ul class="nb-article-list mt-12 space-y-10">
        {articles.map((article) => (
          <li>
            <h2 class="text-heading">
              <a href={articlePath(article.id)} class="text-ink no-underline hover:text-accent-hover">
                {article.data.title}
              </a>
            </h2>
            <p class="kicker mt-2">
              <time datetime={article.data.pubDate.toISOString()}>
                {dateFormat.format(article.data.pubDate)}
              </time>
            </p>
            <p class="mt-2 text-ink-muted">{article.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }

  <p class="mt-6">
    <a href="/rss.xml">Subscribe with RSS</a>
  </p>
</PageLayout>
