---
/**
 * The homepage.
 *
 * Deliberately almost empty. There is nothing published yet, and a homepage
 * that pretended otherwise would be the first thing on the site that was not
 * true. Writing arrives under /writing/, which the header links on every page.
 *
 * The description names CloseBot and the lede does not. The description is
 * metadata for a search result, where one fact helps someone decide whether
 * this is the Max Pattillo they meant; the page itself just says hello.
 */
import PageLayout from '../layouts/PageLayout.astro';
import { person } from '../data/person';
---

<PageLayout
  seo={{
    title: person.name,
    description: `I put my thoughts here sometimes. ${person.name}, developer at CloseBot.`,
  }}
  heading={person.name}
  lede="Hello there."
  register="display"
/>
