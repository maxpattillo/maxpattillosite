---
/**
 * Site footer.
 *
 * Renders the person's name and profiles from the canonical entity in
 * src/data/person.ts -- never retyped here. The same object feeds the Person
 * JSON-LD, so the visible links and the structured data cannot disagree.
 *
 * The copyright year is computed at BUILD time, which is correct for a static
 * site: the value is baked into the HTML and costs no client JavaScript. It
 * updates on the next deploy.
 */
import { footerNav } from '../../data/navigation';
import { person } from '../../data/person';
import { isActivePath } from '../../utils/urls';

const current = Astro.url.pathname;
const year = new Date().getFullYear();
---

{/*
  A solid accent slab: the one large area of colour on any page, which is why
  the accent is a quiet one. Links inside are small dark chips.
*/}
<footer class="mt-24 border-t-[3px] border-line bg-accent text-on-accent">
  <div
    class="mx-auto flex max-w-wide flex-wrap items-baseline justify-between gap-x-8 gap-y-4 px-gutter pt-10 pb-12"
  >
    <p class="text-title">{person.name}</p>

    <nav aria-label="Footer">
      <ul class="flex flex-wrap items-center gap-3">
        {
          footerNav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActivePath(item.href, current) ? 'page' : undefined}
                class="footer-chip"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      /*
        Social profiles, from the same array that produces schema.org `sameAs`.
        Renders nothing while the array is empty — correct, since an empty
        social row looks broken and a guessed URL is worse than none.

        rel="me" is the microformats identity convention: it asserts that the
        linked profile is the same person as this site's owner. Several
        platforms (Mastodon among them) read it to verify ownership, and it
        reinforces the same claim `sameAs` makes in the JSON-LD.

        NOT A <nav>, DELIBERATELY. These links already sit inside the footer
        landmark, so a second landmark would add a name to the list without
        adding a place to go. See AGENTS.md -- "Do not sprinkle landmarks for
        their own sake."
      */
      person.socialProfiles.length > 0 && (
        <ul class="flex flex-wrap items-center gap-3">
          {person.socialProfiles.map((profile) => (
            <li>
              <a href={profile.url} rel="me noopener" class="footer-chip">
                {profile.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <p class="font-mono text-kicker">&copy; {year}</p>
  </div>
</footer>

<style>
  /* Dark chips on the accent slab; only the footer uses them. */
  .footer-chip {
    display: inline-block;
    border: var(--border-heavy) solid var(--color-on-accent);
    background-color: var(--color-surface);
    color: var(--color-ink);
    padding: 0.3rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 3px 3px 0 0 var(--color-on-accent);
  }

  .footer-chip:hover {
    background-color: var(--color-on-accent);
  }
</style>
