---
/**
 * Site header.
 *
 * NO JAVASCRIPT, AND NO MOBILE MENU COMPONENT.
 *
 * The constitution says a hydration directive is only justified when the
 * interaction cannot reasonably be built from native HTML and CSS. The name
 * and one primary link fit on a small screen unaided, so there is nothing to
 * disclose, let alone anything needing JS to disclose it.
 *
 * Social profiles and the source link live in the footer only. The header is
 * `sticky`, so every line it wraps to costs a fixed slice of every viewport.
 *
 * If the PRIMARY nav ever outgrows its line, the next step is a native
 * <details>/<summary> disclosure -- still zero JS. An island is the last
 * resort, not the first.
 */
import { primaryNav } from '../../data/navigation';
import { SITE_NAME } from '../../data/site';
import { isActivePath } from '../../utils/urls';

const current = Astro.url.pathname;
---

{/*
  A panel floating inside the gutter rather than a full-width bar: the mark
  and the site name, then the nav items as buttons. See DESIGN.md.

  Sticky so navigation stays reachable through a long article you scroll for
  several screens. The strip above the panel is transparent on purpose; the
  html scroll-padding in global.css clears both.
*/}
<header class="sticky top-0 z-50 px-gutter pt-4">
  <div class="panel mx-auto flex max-w-wide items-center justify-between gap-4 p-2">
    {/*
      The mark is the favicon, drawn inline so it takes its colours from the
      tokens rather than from a copy of them. Decorative: the name beside it is
      the link's accessible name. Same geometry as renderFavicon in
      scripts/og-card.mjs.
    */}
    <a href="/" class="inline-flex items-center gap-2.5 font-bold text-ink no-underline">
      <svg
        class="size-9 shrink-0"
        viewBox="0 0 16 16"
        shape-rendering="crispEdges"
        aria-hidden="true"
        focusable="false"
      >
        <rect x="5" y="5" width="11" height="11" class="fill-accent" />
        <rect width="11" height="11" class="fill-ink" />
        <rect x="2" y="2" width="7" height="7" class="fill-surface" />
      </svg>
      {SITE_NAME}
    </a>

    <nav aria-label="Primary">
      <ul class="flex items-center gap-3">
        {
          primaryNav.map((item) => (
            <li>
              {/*
                The current page is pressed and filled, not merely recoloured.
                Colour is never the only carrier of meaning.
              */}
              <a
                href={item.href}
                aria-current={isActivePath(item.href, current) ? 'page' : undefined}
                class="button button-ghost"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
