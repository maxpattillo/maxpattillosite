---
/**
 * The only layout that renders <html>. Every public page goes through it,
 * directly or via a more specific layout.
 *
 * It is the enforcement point for the SEO contract:
 *
 *   - `seo` is a REQUIRED prop, parsed through `seoInputSchema`. A page with
 *     no SEO object, a placeholder title, or a missing description fails
 *     `astro build` rather than shipping.
 *   - The canonical URL, Open Graph set, and robots directives are computed
 *     here from `Astro.site` + the current route. Pages never write them, so
 *     they cannot be forgotten or hard-coded to the wrong domain.
 *   - Person, WebSite, and WebPage JSON-LD are always emitted. Templates add
 *     only nodes describing their own content.
 *   - Exactly one <main> exists, and it is here.
 */
import '../styles/global.css';

// Build-time, public, and optional. See the note on `env` in astro.config.ts.
import { CLOSEBOT_SOURCE } from 'astro:env/client';

import SEO from '../components/seo/SEO.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/navigation/Footer.astro';
import { DEFAULT_LANG, SITE_NAME } from '../data/site';
import { resolveSeo } from '../schemas/seo';
import { deriveBreadcrumbs } from '../utils/urls';
import {
  buildBreadcrumbList,
  buildPerson,
  buildWebPage,
  buildWebSite,
  type BreadcrumbItem,
  type JsonLdNode,
} from '../utils/schema';
import type { BaseLayoutProps } from './types';

// PROTOTYPE — neobrutalism site shells. Dev only; null in a build.
import '../prototype/neobrutalism/neobrutalism.css';
import { getVariant } from '../prototype/neobrutalism/variants';
import Switcher from '../prototype/neobrutalism/Switcher.astro';
import ChromeA from '../prototype/neobrutalism/ChromeA.astro';
import ChromeB from '../prototype/neobrutalism/ChromeB.astro';
import ChromeC from '../prototype/neobrutalism/ChromeC.astro';
import ChromeD from '../prototype/neobrutalism/ChromeD.astro';
const variant = getVariant(Astro.url);
const Chrome = variant && { A: ChromeA, B: ChromeB, C: ChromeC, D: ChromeD }[variant];

/** See src/layouts/types.ts -- shared so specific layouts can extend them. */
type Props = BaseLayoutProps;

const {
  seo: seoInput,
  pageType,
  breadcrumbs,
  breadcrumbLabel,
  schema,
  datePublished,
  dateModified,
  width = 'content',
} = Astro.props;

// Narrow Astro.site for the rest of the file. resolveSeo checks this too, but
// TypeScript cannot see through that call.
if (!Astro.site) {
  throw new Error(
    'Astro.site is undefined. Set `site` in astro.config.ts -- canonical URLs, Open Graph URLs, and JSON-LD @ids all derive from it.',
  );
}
const site = Astro.site;

const seo = resolveSeo(seoInput, { site, pathname: Astro.url.pathname });

// One breadcrumb array drives both the visible trail and the BreadcrumbList
// node, so the structured data always describes something on the page.
let crumbs: BreadcrumbItem[] = [];
if (breadcrumbs !== false) {
  crumbs = breadcrumbs ?? deriveBreadcrumbs(Astro.url.pathname, site);
  const last = crumbs.at(-1);
  if (breadcrumbLabel && last) {
    crumbs = [...crumbs.slice(0, -1), { ...last, name: breadcrumbLabel }];
  }
}
// A one-item trail carries no information; don't render or describe it.
const hasBreadcrumb = crumbs.length > 1;

// JSON-LD @ids hang off the page's own URL, which exists even when no
// canonical tag is emitted (the 404 page).
const nodes: JsonLdNode[] = [
  buildPerson(site),
  buildWebSite(site),
  buildWebPage({
    site,
    canonical: seo.url,
    title: seo.title,
    description: seo.description,
    type: pageType,
    hasBreadcrumb,
    datePublished,
    dateModified,
  }),
  ...(hasBreadcrumb ? [buildBreadcrumbList(seo.url, crumbs)] : []),
  ...(schema?.({ site, canonical: seo.url }) ?? []),
];

/*
 * 'full' drops both the measure and the gutter so a full-bleed band can reach
 * the viewport edges. Pages that ask for it restore the measure themselves --
 * see PageLayout.astro.
 */
const measure =
  width === 'full'
    ? 'w-full'
    : `mx-auto w-full px-gutter py-12 ${width === 'wide' ? 'max-w-wide' : 'max-w-content'}`;
---

<!doctype html>
<html lang={DEFAULT_LANG} data-variant={variant ?? undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/*
      Feed autodiscovery. Readers and aggregators look for exactly this link
      rather than guessing /rss.xml, so without it the feed effectively does
      not exist to anything automated.
    */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_NAME} — Writing`}
      href="/rss.xml"
    />

    <SEO seo={seo} schema={nodes} />

    {/*
      CloseBot chat widget -- the Owner's own agent, built on the product of
      the Owner's employer.

      The only script on the site, and the one deliberate exception to the
      "avoid third-party scripts" rule in AGENTS.md.

      `async` so it never blocks parsing or rendering, and `is:inline` so Astro
      leaves the external src alone rather than trying to bundle it.

      Nothing on the site depends on it. It has no .cb-widget-container to bind
      to, so it mounts its own floating widget; if it fails to load, no content
      and no navigation is affected.

      RENDERED ONLY WHEN AN ACCOUNT IS CONFIGURED. `CLOSEBOT_SOURCE` is a build
      variable, not a hard-coded id -- see the long note in astro.config.ts for
      why. No value means no widget, which is what keeps a fork from silently
      loading the Owner's agent. The script budget is therefore one WHEN
      CONFIGURED and zero without, and tests/e2e/no-js.spec.ts asserts
      whichever applies rather than a fixed number.
    */}
    {
      CLOSEBOT_SOURCE && (
        <script
          is:inline
          src={`https://api.closebot.com/scripts/cb.js?source=${CLOSEBOT_SOURCE}`}
          async
        />
      )
    }

    {/* Escape hatch for genuinely page-specific head content. Never metadata. */}
    <slot name="head" />

    {
      variant && (
        <Fragment>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&family=Space+Grotesk:wght@400;500;700&display=swap"
          />
        </Fragment>
      )
    }
  </head>

  <body class="flex min-h-screen flex-col">
    <a class="skip-link" href="#main">Skip to content</a>

    {
      Chrome && variant ? (
        <Fragment>
          <Chrome
            crumbs={crumbs}
            hasBreadcrumb={hasBreadcrumb}
            measure={Astro.url.pathname === '/' ? measure.replace('max-w-content', 'max-w-wide') : measure}
          >
            <slot />
          </Chrome>
          <Switcher current={variant} />
        </Fragment>
      ) : (
        <Fragment>
          <Header />

          <main id="main" class={`flex-1 ${measure}`}>
            {
              /*
               * In 'full' the main element has no gutter, so the trail has to carry
               * its own or it sits flush against the viewport edge.
               */
              hasBreadcrumb &&
                (width === 'full' ? (
                  <div class="mx-auto w-full max-w-wide px-gutter pt-8">
                    <Breadcrumbs items={crumbs} />
                  </div>
                ) : (
                  <Breadcrumbs items={crumbs} />
                ))
            }
            <slot />
          </main>

          <Footer />
        </Fragment>
      )
    }
  </body>
</html>
